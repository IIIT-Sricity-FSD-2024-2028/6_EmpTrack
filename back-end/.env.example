PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins, e.g. http://localhost:5500,https://app.example.com
# Leave unset to allow all origins (matches previous behavior of app.enableCors()).
CORS_ORIGIN=

LOG_LEVEL=INFO
LOG_DIR=logs

UPLOAD_DIR=uploads
# Durable SQLite file used only for issues and escalations. Requires Node.js >= 22.5.
EMPTRACK_WORKFLOW_DB=data/workflow.sqlite
# Hard ceiling (bytes) enforced by Multer before any per-category check runs.
MAX_FILE_SIZE=10485760
